 запитати ім’я на ти?","en":"How do you ask someone’s name informally?","es":"Elige la pregunta correcta."},"options":["¿Cómo te llamas?","¿Cómo se llama tú?","¿Qué te llamas?"],"answer":"¿Cómo te llamas?"},{"id":"in6","tag":"origin","prompt":{"ru":"Я живу в Эльче.","uk":"Я живу в Ельче.","en":"I live in Elche.","es":"Elige la frase correcta."},"options":["Vivo en Elche.","Soy en Elche.","Tengo en Elche."],"answer":"Vivo en Elche."},{"id":"in7","tag":"farewell","prompt":{"ru":"Для женщины: «приятно познакомиться».","uk":"Для жінки: «приємно познайомитися».","en":"For a woman: “Nice to meet you.”","es":"Elige la forma femenina."},"options":["Encantada.","Encantado.","Encantar."],"answer":"Encantada."},{"id":"in8","tag":"greeting","prompt":{"ru":"Привет.","uk":"Привіт.","en":"Hello.","es":"Elige el saludo."},"options":["Hola.","Adiós.","Gracias."],"answer":"Hola."},{"id":"in9","tag":"name","prompt":{"ru":"Я Карлос.","uk":"Я Карлос.","en":"I am Carlos.","es":"Elige la frase correcta."},"options":["Soy Carlos.","Estoy Carlos.","Me es Carlos."],"answer":"Soy Carlos."},{"id":"in10","tag":"farewell","prompt":{"ru":"«До скорого»","uk":"«До зустрічі»","en":"“See you later”","es":"Elige la expresión correcta."},"options":["Hasta luego.","Por favor.","Buenos días."],"answer":"Hasta luego."}]}}
